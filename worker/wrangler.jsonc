{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "costa",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  // Built client (npm run build) served as static files; everything else hits the Worker.
  "assets": { "directory": "../client/dist", "binding": "ASSETS" },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "GameRoom" },
      { "name": "LOBBY", "class_name": "Lobby" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom", "Lobby"] }],
  "observability": { "enabled": true }
}
